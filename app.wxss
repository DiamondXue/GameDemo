/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 全局容器 */
.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 */
.btn-primary {
  background-color: #ff6b6b;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 0;
  border: none;
  width: 100%;
}

.btn-primary:active {
  background-color: #ff5252;
}

.btn-secondary {
  background-color: #4ecdc4;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-secondary:active {
  background-color: #3dbdb4;
}

/* 文本样式 */
.text-primary {
  color: #ff6b6b;
}

.text-secondary {
  color: #4ecdc4;
}

.text-gold {
  color: #feca57;
}

.text-gray {
  color: #dfe6e9;
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 500;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

/* 诗句样式 */
.poem-text {
  font-size: 32rpx;
  font-style: italic;
  color: #555555;
  line-height: 1.8;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #dfe6e9;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b, #feca57);
  transition: width 0.3s ease;
}

/* 数字卡片 */
.digit-card {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #feca57, #ff6b6b);
  border-radius: 16rpx;
  font-size: 60rpx;
  font-weight: bold;
  color: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(255, 107, 107, 0.3);
}

.digit-card.locked {
  background: #dfe6e9;
  box-shadow: none;
}

/* 状态标签 */
.status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-success {
  background-color: #4ecdc4;
  color: #ffffff;
}

.status-pending {
  background-color: #dfe6e9;
  color: #666666;
}

.status-locked {
  background-color: #95a5a6;
  color: #ffffff;
}

/* 图标 */
.icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #e0e0e0;
  margin: 30rpx 0;
}

/* Flex布局辅助类 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 间距辅助类 */
.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.mr-10 {
  margin-right: 10rpx;
}

.p-20 {
  padding: 20rpx;
}

.p-30 {
  padding: 30rpx;
}
