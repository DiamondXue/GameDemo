/* pages/admin-location/admin-location.wxss */
.admin-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 当前状态 */
.current-status {
  border-left: 6rpx solid #ff6b6b;
}

.status-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.status-badge.active {
  background-color: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.status-badge.inactive {
  background-color: #fff7e6;
  color: #fa8c16;
  border: 1rpx solid #ffd591;
}

.status-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.status-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
}

.status-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-item {
  font-size: 24rpx;
  color: #666666;
}

/* 地图 */
.map-section {
  padding: 16rpx;
}

.location-map {
  width: 100%;
  height: 500rpx;
  border-radius: 12rpx;
}

.map-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 表单 */
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 28rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.coord-row {
  display: flex;
  gap: 16rpx;
}

.coord-input {
  flex: 1;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-small {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #333333;
  border-radius: 8rpx;
  padding: 0;
  border: none;
}

.btn-small::after {
  border: none;
}

/* 范围选择 */
.radius-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.btn-minus, .btn-plus {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  background-color: #f0f0f0;
  color: #333333;
  border-radius: 50%;
  padding: 0;
  border: none;
}

.btn-minus::after, .btn-plus::after {
  border: none;
}

.radius-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
  min-width: 200rpx;
  text-align: center;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 20rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* 预设 */
.preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.preset-btn {
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #333333;
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  margin: 0;
  line-height: 1.5;
  border: none;
}

.preset-btn::after {
  border: none;
}

/* 历史 */
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.history-detail {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.history-time {
  font-size: 22rpx;
  color: #cccccc;
  margin-bottom: 4rpx;
}

.history-badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  width: fit-content;
}

.history-badge.active {
  background-color: #f6ffed;
  color: #52c41a;
}

.history-badge.inactive {
  background-color: #f5f5f5;
  color: #999999;
}

.btn-disable {
  font-size: 22rpx;
  background-color: #fff1f0;
  color: #ff4d4f;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  margin: 0;
  line-height: 1.5;
  border: none;
  height: auto;
}

.btn-disable::after {
  border: none;
}
