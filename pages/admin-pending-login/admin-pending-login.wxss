/* pages/admin-pending-login/admin-pending-login.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #ff6b6b, #ffa726);
  color: white;
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.export-btn {
  background: rgba(255,255,255,0.25);
  color: white;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 30rpx;
  font-size: 24rpx;
  line-height: 2.2;
  padding: 0 24rpx;
  display: inline-block;
}

.search-bar {
  display: flex;
  padding: 20rpx 30rpx;
  background: white;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
}

.refresh-btn {
  background: #ff6b6b;
  color: white;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.dept-tabs {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  padding: 20rpx 30rpx;
  background: white;
  gap: 16rpx;
  -webkit-overflow-scrolling: touch;
}

.dept-tabs::-webkit-scrollbar {
  display: none;
}

.dept-tab {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: #f0f0f0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.dept-tab.active {
  background: #ff6b6b;
  color: white;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #4caf50;
  font-size: 32rpx;
}

.employee-list {
  margin: 20rpx;
}

.employee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.emp-info {
  display: flex;
  flex-direction: column;
}

.emp-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.emp-id {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.emp-dept {
  font-size: 24rpx;
  color: #666;
}

.emp-status {
  background: #fff3e0;
  color: #ff9800;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}