/* pages/create-game/create-game.wxss */
.create-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.section {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 管理入口 */
.admin-entry {
  padding: 0;
  overflow: hidden;
}

.admin-link {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.admin-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.admin-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.admin-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.admin-desc {
  font-size: 22rpx;
  color: #999999;
}

.admin-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 分组设置 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-label {
  font-size: 28rpx;
  color: #333333;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  font-size: 36rpx;
  color: #333333;
}

.stepper-btn:active {
  background-color: #e0e0e0;
}

.stepper-value {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 分组模式切换 */
.mode-switch {
  display: flex;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #999999;
  border-radius: 10rpx;
  transition: all 0.2s;
}

.mode-tab.active {
  background-color: #ffffff;
  color: #ff6b6b;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 自定义分组摘要 */
.custom-group-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.summary-item {
  background-color: #fff5f5;
  color: #ff6b6b;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.summary-item.empty {
  background-color: #f8f9fa;
  color: #cccccc;
}

/* 分组分配 */
.assignment-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.assignment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.assignment-header .section-title {
  margin-bottom: 0;
}

.batch-actions {
  display: flex;
  gap: 16rpx;
}

.batch-btn {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 500;
  padding: 8rpx 16rpx;
  background-color: #fff5f5;
  border-radius: 8rpx;
}

/* 批量操作栏 */
.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.batch-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.batch-count {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.batch-select-all {
  font-size: 24rpx;
  color: #ff6b6b;
}

.batch-assign-btn {
  background-color: #ff6b6b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
}

.batch-assign-btn:active {
  opacity: 0.85;
}

/* 复选框 */
.batch-check {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.batch-checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #ffffff;
  transition: all 0.2s;
}

.batch-checkbox.checked {
  background-color: #ff6b6b;
  border-color: #ff6b6b;
  color: #ffffff;
}

/* 组号标签 */
.assignment-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.group-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.group-tag-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 批量模式下的员工项 */
.assignment-item.batch-mode {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-bottom: none;
}

.assignment-item.batch-mode:nth-child(odd) {
  background-color: #f5f5f5;
}

.assignment-list {
  max-height: 800rpx;
  overflow-y: auto;
}

.assignment-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.assignment-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.assignment-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.assignment-dept {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.assignment-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 组号选择器弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 32rpx;
}

.group-picker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.group-picker-item {
  flex: 0 0 calc(33.33% - 12rpx);
  text-align: center;
  padding: 20rpx 0;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.group-picker-item.active {
  background-color: #fff5f5;
  border-color: #ff6b6b;
  color: #ff6b6b;
  font-weight: 600;
}

.group-picker-item:active {
  opacity: 0.85;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background-color: #f8f9fa;
  color: #666666;
}

.modal-btn.confirm {
  background-color: #ff6b6b;
  color: #ffffff;
}

.modal-btn:active {
  opacity: 0.85;
}

.capacity-info {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.capacity-current {
  font-weight: 500;
}

.capacity-current.over {
  color: #e74c3c;
}

/* 选择参与者 */
.select-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.select-header .section-title {
  margin-bottom: 0;
}

.select-all {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.dept-filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.dept-arrow {
  font-size: 20rpx;
  color: #999999;
}

.dept-list {
  margin-bottom: 16rpx;
}

.dept-item {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #666666;
  border-bottom: 1rpx solid #f0f0f0;
}

.dept-item.active {
  color: #ff6b6b;
  font-weight: 500;
  background-color: #fff5f5;
}

.emp-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.emp-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.emp-item.selected {
  background-color: #fff5f5;
}

.emp-check {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.emp-item.selected .emp-check {
  background-color: #ff6b6b;
  border-color: #ff6b6b;
  color: #ffffff;
}

.emp-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.emp-id {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.emp-name {
  font-size: 24rpx;
  color: #666666;
}

.emp-dept {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
/* 打卡点入口 */
.spot-entry {
  padding: 0;
  overflow: hidden;
}

.spot-link {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.spot-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.spot-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.spot-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.spot-desc {
  font-size: 22rpx;
  color: #999;
}

.spot-arrow {
  font-size: 28rpx;
  color: #ccc;
}
