/* pages/create-game/create-game.wxss */
.create-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.section {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 管理入口 */
.admin-entry {
  padding: 0;
  overflow: hidden;
}

.admin-link {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.admin-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.admin-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.admin-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.admin-desc {
  font-size: 22rpx;
  color: #999999;
}

.admin-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 分组设置 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-label {
  font-size: 28rpx;
  color: #333333;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f0f0f0;
  border-radius: 12rpx;
  font-size: 36rpx;
  color: #333333;
}

.stepper-btn:active {
  background-color: #e0e0e0;
}

.stepper-value {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.capacity-info {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.capacity-current {
  font-weight: 500;
}

.capacity-current.over {
  color: #e74c3c;
}

/* 选择参与者 */
.select-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.select-header .section-title {
  margin-bottom: 0;
}

.select-all {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.dept-filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #333333;
}

.dept-arrow {
  font-size: 20rpx;
  color: #999999;
}

.dept-list {
  margin-bottom: 16rpx;
}

.dept-item {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #666666;
  border-bottom: 1rpx solid #f0f0f0;
}

.dept-item.active {
  color: #ff6b6b;
  font-weight: 500;
  background-color: #fff5f5;
}

.emp-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.emp-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.emp-item.selected {
  background-color: #fff5f5;
}

.emp-check {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.emp-item.selected .emp-check {
  background-color: #ff6b6b;
  border-color: #ff6b6b;
  color: #ffffff;
}

.emp-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.emp-id {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.emp-name {
  font-size: 24rpx;
  color: #666666;
}

.emp-dept {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

/* 提交按钮 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
