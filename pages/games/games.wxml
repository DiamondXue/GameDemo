<!--pages/games/games.wxml-->
<view class="games-container">
  <!-- 用户信息 -->
  <view class="user-section card">
    <view class="user-info">
      <view class="user-avatar">
        <text class="avatar-text">{{userInfo.employeeId ? userInfo.employeeId.slice(-4) : '?'}}</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.name || userInfo.employeeId}}</text>
        <text class="user-dept">{{userInfo.department}}</text>
        <text class="admin-badge" wx:if="{{userInfo.isAdmin}}">管理员</text>
      </view>
    </view>
    <view class="action-btn" bindtap="goToCreateGame" wx:if="{{userInfo.isAdmin}}">
      <text class="action-text">+ 创建游戏</text>
    </view>
    <view class="action-btn secondary" bindtap="goToPendingLogin" wx:if="{{userInfo.isAdmin}}">
      <text class="action-text">未登录员工</text>
    </view>
  </view>

  <!-- 游戏列表 -->
  <view class="section-header">
    <text class="section-title">我的游戏</text>
    <text class="section-count">共 {{games.length}} 个</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="games-section" wx:elif="{{games.length > 0}}">
    <view
      class="game-card card {{item.status}}"
      wx:for="{{games}}"
      wx:key="gameId"
      bindtap="enterGame"
      data-game="{{item}}"
    >
      <view class="game-header">
        <view class="game-status {{item.status}}">
          <text wx:if="{{item.status === 'pending'}}">待开始</text>
          <text wx:elif="{{item.status === 'active'}}">进行中</text>
          <text wx:elif="{{item.status === 'finished'}}">已结束</text>
          <text wx:else>已取消</text>
        </view>
        <text class="game-date">{{item.createdAt}}</text>
      </view>

      <text class="game-name">{{item.name}}</text>
      <text class="game-desc" wx:if="{{item.description}}">{{item.description}}</text>

      <view class="game-footer">
        <view class="game-tag" wx:if="{{item.status === 'pending'}}">
          <text class="tag-text">待确认分组</text>
        </view>
        <view class="game-tag" wx:else>
          <text class="tag-text">第 {{item.groupNumber}} 组</text>
        </view>
        <view class="game-tag">
          <text class="tag-text">{{item.participantCount}} 人</text>
        </view>
        <view class="game-tag">
          <text class="tag-text">{{item.groupCount}} 组</text>
        </view>
      </view>

      <!-- 管理员控制按钮 -->
      <view class="admin-actions" wx:if="{{userInfo.isAdmin}}" catchtap="stopProp">
        <!-- 待开始：显示开始和取消 -->
        <view
          class="admin-btn btn-start"
          wx:if="{{item.status === 'pending'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="start"
        >
          <text>开始游戏</text>
        </view>
        <view
          class="admin-btn btn-cancel"
          wx:if="{{item.status === 'pending'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="cancel"
        >
          <text>取消</text>
        </view>
        
        <!-- 进行中：显示结束和取消 -->
        <view
          class="admin-btn btn-finish"
          wx:if="{{item.status === 'active'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="finish"
        >
          <text>结束游戏</text>
        </view>
        <view
          class="admin-btn btn-cancel"
          wx:if="{{item.status === 'active'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="cancel"
        >
          <text>取消</text>
        </view>
        
        <!-- 已结束/已取消：显示删除 -->
        <view
          class="admin-btn btn-delete"
          wx:if="{{item.status === 'finished' || item.status === 'cancelled'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="delete"
        >
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">🎮</text>
    <text class="empty-text">暂无可参与的游戏</text>
    <text class="empty-hint" wx:if="{{userInfo.isAdmin}}">点击上方"创建游戏"开始新游戏</text>
  </view>
</view>