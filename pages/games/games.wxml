<!--pages/games/games.wxml-->
<view class="games-container">
  <!-- 用户信息 -->
  <view class="user-section card">
    <view class="user-info">
      <view class="user-avatar">
        <text class="avatar-text">{{userInfo.employeeId ? userInfo.employeeId.slice(-4) : '?'}}</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.name || userInfo.employeeId}}</text>
        <text class="user-dept">{{userInfo.department}}</text>
        <text class="admin-badge" wx:if="{{userInfo.isAdmin}}">管理员</text>
      </view>
    </view>
    <view class="action-btn" bindtap="goToCreateGame" wx:if="{{userInfo.isAdmin}}">
      <text class="action-text">+ 创建游戏</text>
    </view>
    <view class="action-btn secondary" bindtap="goToPendingLogin" wx:if="{{userInfo.isAdmin}}">
      <text class="action-text">未登录员工</text>
    </view>
    <view class="action-btn test" bindtap="runPerformanceTest" wx:if="{{userInfo.isAdmin}}">
      <text class="action-text">性能测试</text>
    </view>
  </view>

  <!-- 游戏列表 -->
  <view class="section-header">
    <text class="section-title">我的游戏</text>
    <text class="section-count">共 {{games.length}} 个</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="games-section" wx:elif="{{games.length > 0}}">
    <view
      class="game-card card {{item.status}}"
      wx:for="{{games}}"
      wx:key="gameId"
      bindtap="enterGame"
      data-game="{{item}}"
    >
      <view class="game-header">
        <view class="game-status {{item.status}}">
          <text wx:if="{{item.status === 'pending'}}">待开始</text>
          <text wx:elif="{{item.status === 'active'}}">进行中</text>
          <text wx:elif="{{item.status === 'finished'}}">已结束</text>
          <text wx:else>已取消</text>
        </view>
        <text class="game-date">{{item.createdAt}}</text>
      </view>

      <text class="game-name">{{item.name}}</text>
      <text class="game-desc" wx:if="{{item.description}}">{{item.description}}</text>

      <view class="game-footer">
        <view class="game-tag" wx:if="{{item.status === 'pending'}}">
          <text class="tag-text">待确认分组</text>
        </view>
        <view class="game-tag" wx:else>
          <text class="tag-text">第 {{item.groupNumber}} 组</text>
        </view>
        <view class="game-tag">
          <text class="tag-text">{{item.participantCount}} 人</text>
        </view>
        <view class="game-tag">
          <text class="tag-text">{{item.groupCount}} 组</text>
        </view>
      </view>

      <!-- 管理员控制按钮 -->
      <view class="admin-actions" wx:if="{{userInfo.isAdmin}}" catchtap="stopProp">
        <!-- 待开始：显示开始和取消 -->
        <view
          class="admin-btn btn-start"
          wx:if="{{item.status === 'pending'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="start"
        >
          <text>开始游戏</text>
        </view>
        <view
          class="admin-btn btn-cancel"
          wx:if="{{item.status === 'pending'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="cancel"
        >
          <text>取消</text>
        </view>

        <!-- 进行中：显示结束和取消 -->
        <view
          class="admin-btn btn-finish"
          wx:if="{{item.status === 'active'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="finish"
        >
          <text>结束游戏</text>
        </view>
        <view
          class="admin-btn btn-cancel"
          wx:if="{{item.status === 'active'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="cancel"
        >
          <text>取消</text>
        </view>

        <!-- 已结束/已取消：显示删除 -->
        <view
          class="admin-btn btn-delete"
          wx:if="{{item.status === 'finished' || item.status === 'cancelled'}}"
          bindtap="onGameAction"
          data-gameid="{{item.gameId}}"
          data-action="delete"
        >
          <text>删除</text>
        </view>
      </view>

      <!-- 数据面板按钮（所有人可见） -->
      <view class="dashboard-btn-wrap" wx:if="{{item.status === 'active' || item.status === 'finished'}}" catchtap="stopProp">
        <view class="dashboard-btn" bindtap="viewDashboard" data-game="{{item}}">
          <text>数据面板</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">🎮</text>
    <text class="empty-text">暂无可参与的游戏</text>
    <text class="empty-hint" wx:if="{{userInfo.isAdmin}}">点击上方"创建游戏"开始新游戏</text>
  </view>

  <!-- 性能测试结果 -->
  <view class="test-result card" wx:if="{{testResult && testResult.success}}">
    <view class="test-header">
      <text class="test-title">性能测试结果</text>
      <text class="test-close" bindtap="dismissTestResult">✕</text>
    </view>

    <!-- 登录测试 -->
    <view class="test-section" wx:if="{{testResult.loginTest}}">
      <text class="test-section-title">登录测试 (200人并发)</text>
      <view class="test-stats">
        <view class="stat-item">
          <text class="stat-value {{testResult.loginTest.failCount > 0 ? 'warn' : 'good'}}">{{testResult.loginTest.successCount}}/{{testResult.loginTest.successCount + testResult.loginTest.failCount}}</text>
          <text class="stat-label">成功/总数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.loginTest.totalTime}}ms</text>
          <text class="stat-label">总耗时</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.loginTest.avgTime}}ms</text>
          <text class="stat-label">平均响应</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.loginTest.p95}}ms</text>
          <text class="stat-label">P95</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.loginTest.maxTime}}ms</text>
          <text class="stat-label">最慢</text>
        </view>
      </view>
    </view>

    <!-- 分组测试 -->
    <view class="test-section" wx:if="{{testResult.groupingTest && testResult.groupingTest.success}}">
      <text class="test-section-title">分组测试</text>
      <view class="test-stats">
        <view class="stat-item">
          <text class="stat-value">{{testResult.groupingTest.groupCount}}</text>
          <text class="stat-label">分组数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.groupingTest.participantCount}}</text>
          <text class="stat-label">参与人数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.groupingTest.createTime}}ms</text>
          <text class="stat-label">创建耗时</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.groupingTest.groupSizes.min}}-{{testResult.groupingTest.groupSizes.max}}</text>
          <text class="stat-label">每组人数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{testResult.groupingTest.groupSizes.stdDev}}</text>
          <text class="stat-label">标准差</text>
        </view>
      </view>
      <text class="test-game-id">gameId: {{testResult.groupingTest.gameId}}</text>
    </view>

    <!-- 分组预览 -->
    <view class="test-section" wx:if="{{testResult.groupingTest && testResult.groupingTest.fullGrouping}}">
      <text class="test-section-title">分组详情（共{{testResult.groupingTest.groupCount}}组，点击组号展开成员）</text>
      <scroll-view scroll-y class="test-groups-scroll">
        <view
          class="test-group-row"
          wx:for="{{testResult.groupingTest.fullGrouping}}"
          wx:key="groupNumber"
          bindtap="toggleGroupMembers"
          data-idx="{{index}}"
        >
          <text class="test-group-num">第{{item.groupNumber}}组</text>
          <text class="test-group-count">{{item.count}}人</text>
          <text class="test-group-toggle">{{expandedGroups[index] ? '收起' : '展开'}}</text>
          <view class="test-group-members" wx:if="{{expandedGroups[index]}}">
            <text class="member-id" wx:for="{{item.members}}" wx:key="*this" wx:for-item="mid">{{mid}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>