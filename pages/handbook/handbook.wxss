/* pages/handbook/handbook.wxss */
.handbook-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.header-section {
  background: linear-gradient(135deg, #4ecdc4, #44a8a0);
  color: #ffffff;
  padding: 40rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.poems-section {
  margin-bottom: 20rpx;
}

.poem-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.poem-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.spot-badge {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff6b6b, #feca57);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.spot-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.spot-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}

.poem-content {
  background-color: #f8f9fa;
  border-left: 4rpx solid #4ecdc4;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.poem-text {
  font-size: 30rpx;
  font-style: italic;
  color: #555555;
  line-height: 1.8;
  display: block;
}

.poem-hint {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background-color: #fff9e6;
  border-radius: 8rpx;
}

.hint-label {
  font-size: 24rpx;
  color: #e6a23c;
  font-weight: 500;
  margin-right: 8rpx;
}

.hint-text {
  flex: 1;
  font-size: 24rpx;
  color: #856404;
  line-height: 1.5;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.guide-section {
  margin-bottom: 20rpx;
}

.guide-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.guide-step {
  width: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #ff6b6b;
  flex-shrink: 0;
}

.guide-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}
