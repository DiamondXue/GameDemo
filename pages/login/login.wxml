<!--pages/login/login.wxml-->
<view class="login-container">
  <view class="header">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="game-title">六景寻密令</text>
    <text class="game-subtitle">集齐数字，破解密令</text>
  </view>

  <view class="login-form card">
    <view class="form-item">
      <text class="label">选择组号</text>
      <input 
        class="input"
        type="number"
        placeholder="请输入组号（1-12）"
        value="{{teamNumber}}"
        bindinput="onTeamNumberInput"
        maxlength="2"
      />
    </view>

    <view class="form-item">
      <text class="label">队员姓名（最多5人）</text>
      <view class="members-list">
        <input 
          wx:for="{{members}}" 
          wx:key="index"
          class="input member-input"
          placeholder="队员{{index + 1}}（选填）"
          value="{{item}}"
          bindinput="onMemberInput"
          data-index="{{index}}"
          maxlength="20"
        />
      </view>
    </view>

    <button 
      class="btn-primary login-btn" 
      bindtap="handleLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      开始寻密
    </button>
  </view>

  <view class="tips">
    <text class="tip-text">💡 温馨提示</text>
    <text class="tip-content">1. 每个组号对应不同的寻密路线</text>
    <text class="tip-content">2. 需到达景点附近50米内才能打卡</text>
    <text class="tip-content">3. 收集3个数字即可组成最终密令</text>
  </view>
</view>
