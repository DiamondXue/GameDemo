<!--pages/login/login.wxml-->
<view class="login-container">
  <view class="header">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="game-title">六景寻密令</text>
    <text class="game-subtitle">集齐数字，破解密令</text>
  </view>

  <view class="login-form card">
    <view class="form-item">
      <text class="label">员工号登录</text>
      <input
        class="input"
        type="number"
        placeholder="请输入8位员工号"
        value="{{employeeId}}"
        bindinput="onEmployeeIdInput"
        maxlength="8"
      />
    </view>

    <button
      class="btn-primary login-btn"
      bindtap="handleLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      登录
    </button>
  </view>

  <view class="tips">
    <text class="tip-text">💡 温馨提示</text>
    <text class="tip-content">1. 请使用公司8位员工号登录</text>
    <text class="tip-content">2. 登录后可查看可参与的游戏</text>
    <text class="tip-content">3. 系统将根据部门自动分组</text>
  </view>
</view>
