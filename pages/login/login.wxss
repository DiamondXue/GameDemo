/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.game-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.game-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 地理位置验证区域 */
.location-section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.location-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.location-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.location-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.location-info {
  margin-bottom: 24rpx;
}

.location-name {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.location-detail {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

.location-radius {
  display: block;
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.location-status {
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.status-text {
  display: block;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
}

.status-text.located {
  color: #52c41a;
  font-weight: 500;
}

.status-text.not_in_range {
  color: #ff4d4f;
  font-weight: 500;
}

.status-text.error {
  color: #ff4d4f;
}

.status-text.locating {
  color: #1890ff;
}

.status-text.init {
  color: #999999;
}

.btn-location {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #f0f0f0;
  color: #333333;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.btn-location::after {
  border: none;
}

.btn-location[disabled] {
  background-color: #f0f0f0;
  color: #999999;
}

/* 登录表单 */
.login-form {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.members-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.member-input {
  background-color: #f8f9fa;
}

.login-btn {
  margin-top: 60rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* 提示 */
.tips {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 30rpx;
  backdrop-filter: blur(10rpx);
}

.tip-text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.tip-content {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
  line-height: 1.6;
}
