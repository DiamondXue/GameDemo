/* pages/map/map.wxss */
.map-container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.map-view {
  width: 100%;
  height: 500rpx;
}

.refresh-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.refresh-icon {
  font-size: 36rpx;
}

.spot-list {
  flex: 1;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.list-count {
  font-size: 24rpx;
  color: #999999;
}

.spot-scroll {
  height: calc(100vh - 600rpx);
}

.spot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.spot-item:active {
  background-color: #e9ecef;
}

.spot-item.checked {
  opacity: 0.6;
}

.spot-main {
  display: flex;
  align-items: center;
  flex: 1;
}

.spot-badge {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff6b6b, #feca57);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.spot-number {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.spot-info {
  flex: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.spot-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.spot-distance {
  font-size: 24rpx;
  color: #666666;
}

.spot-action {
  margin-left: 16rpx;
}

.checked-badge {
  font-size: 24rpx;
  color: #4ecdc4;
  font-weight: 500;
}

.nav-icon {
  font-size: 32rpx;
  color: #ff6b6b;
}
