/* pages/progress/progress.wxss */
.progress-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.header-section {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  color: #ffffff;
  padding: 40rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
}

.content-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.overview-card {
  padding: 30rpx;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.overview-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.progress-text {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.digits-section {
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.digits-grid {
  display: flex;
  justify-content: space-around;
  gap: 20rpx;
}

.digit-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.digit-card {
  width: 140rpx;
  height: 140rpx;
  position: relative;
  background: linear-gradient(135deg, #feca57, #ff6b6b);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(255, 107, 107, 0.3);
}

.digit-item.locked .digit-card {
  background: #dfe6e9;
  box-shadow: none;
}

.digit-number {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 68rpx;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.digit-lock {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 56rpx;
}

.digit-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.digit-spot {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

.code-section {
  padding: 40rpx;
  text-align: center;
}

.final-code {
  margin: 30rpx 0;
  padding: 40rpx;
  background: linear-gradient(135deg, #ff6b6b, #feca57);
  border-radius: 20rpx;
}

.code-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 20rpx;
}

.verify-btn {
  margin-top: 30rpx;
}

.empty-code {
  margin: 30rpx 0;
  padding: 60rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 30rpx;
}

.records-section {
  padding: 30rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.record-icon {
  width: 48rpx;
  height: 48rpx;
  background-color: #4ecdc4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-spot {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
}

.record-digit {
  margin-left: 16rpx;
}

.digit-badge {
  display: inline-block;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: linear-gradient(135deg, #feca57, #ff6b6b);
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}
