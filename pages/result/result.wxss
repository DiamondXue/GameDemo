/* pages/result/result.wxss */
.result-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.header-section {
  text-align: center;
  padding: 60rpx 40rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: #666666;
}

.digits-display {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.digits-list {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.digit-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #feca57, #ff6b6b);
  border-radius: 16rpx;
  min-width: 120rpx;
}

.digit-number {
  font-size: 60rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.digit-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hint-text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background-color: #fff9e6;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #856404;
}

.hint-icon {
  margin-right: 8rpx;
}

.input-section {
  margin-bottom: 20rpx;
  padding: 40rpx;
}

.code-input-wrapper {
  margin-bottom: 30rpx;
}

.code-input {
  width: 100%;
  height: 120rpx;
  background-color: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  color: #333333;
  letter-spacing: 20rpx;
}

.verify-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.success-section {
  margin-bottom: 20rpx;
  padding: 50rpx;
  text-align: center;
  background: linear-gradient(135deg, #4ecdc4, #44a8a0);
}

.success-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.success-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.success-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 30rpx;
}

.success-code {
  padding: 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

.code-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 16rpx;
}

.code-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 16rpx;
}

.tips-section {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.tip-dot {
  font-size: 28rpx;
  color: #ff6b6b;
  margin-right: 12rpx;
  line-height: 1.5;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.answer-section {
  padding: 20rpx;
  text-align: center;
}

.answer-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
