/* pages/spot-picker/spot-picker.wxss */
.picker-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.spot-map {
  width: 100%;
  height: 45vh;
}

.tip {
  text-align: center;
  font-size: 12px;
  color: #888;
  padding: 8px 0;
  background: #f5f5f5;
}

.spot-list-section {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.list-title {
  font-size: 15px;
  font-weight: 500;
}

.select-all {
  font-size: 13px;
  color: #1890ff;
}

.spot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
  margin-bottom: 8px;
  border-radius: 8px;
  border: 1px solid #e8e8e8;
  background: #fff;
}

.spot-item.selected {
  border-color: #1890ff;
  background: #e6f7ff;
}

.spot-main {
  display: flex;
  align-items: center;
  flex: 1;
}

.spot-check {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 1px solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  font-size: 14px;
  color: #1890ff;
}

.selected .spot-check {
  background: #1890ff;
  color: #fff;
  border-color: #1890ff;
}

.spot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.spot-name {
  font-size: 15px;
  font-weight: 500;
}

.spot-coord {
  font-size: 12px;
  color: #888;
  margin-top: 4px;
}

.spot-radius {
  font-size: 12px;
  color: #888;
}

.spot-custom {
  font-size: 11px;
  color: #ff4d4f;
  border: 1px solid #ff4d4f;
  border-radius: 4px;
  padding: 2px 6px;
}

.spot-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-left: 12px;
}

.action-edit {
  font-size: 12px;
  color: #1890ff;
  padding: 4px 8px;
  border: 1px solid #1890ff;
  border-radius: 4px;
}

.action-delete {
  font-size: 12px;
  color: #ff4d4f;
  padding: 4px 8px;
  border: 1px solid #ff4d4f;
  border-radius: 4px;
}

.confirm-section {
  padding: 12px;
  background: #fff;
  border-top: 1px solid #e8e8e8;
}

.confirm-btn {
  background: #1890ff;
  color: #fff;
  border-radius: 8px;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 12px;
  padding: 24px;
}

.modal-title {
  font-size: 17px;
  font-weight: 500;
  text-align: center;
  margin-bottom: 20px;
}

.modal-body .form-group {
  margin-bottom: 16px;
}

.form-label {
  font-size: 13px;
  color: #666;
  margin-bottom: 6px;
  display: block;
}

.form-input {
  border: 1px solid #e8e8e8;
  border-radius: 6px;
  padding: 8px 12px;
  font-size: 14px;
}

.coord-text {
  font-size: 13px;
  color: #333;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stepper-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.stepper-value {
  font-size: 16px;
  min-width: 40px;
  text-align: center;
}

.modal-footer {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.btn-cancel {
  flex: 1;
  background: #f0f0f0;
  border-radius: 8px;
  padding: 10px;
  text-align: center;
}

.btn-primary {
  flex: 1;
  background: #1890ff;
  color: #fff;
  border-radius: 8px;
  padding: 10px;
  text-align: center;
}
